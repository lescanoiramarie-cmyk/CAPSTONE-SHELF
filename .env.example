# Supabase Configuration
# Use different projects for local development and production
# Local: supabase config.toml project_id (e.g., "shelf-ilms-local")
# Production: Vercel project Supabase URL and anon key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Geoapify Geocoding API (optional; used for library address suggestions and map pins)
# Restrict this browser key to your deployed app origins in the Geoapify dashboard.
VITE_GEOAPIFY_API_KEY=

# Analytics API (optional)
VITE_ANALYTICS_API_URL=http://localhost:8000
